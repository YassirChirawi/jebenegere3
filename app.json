{
  "expo": {
    "name": "Jeben Gere3",
    "slug": "jeben-gere3",
    "scheme": "jebengere3",
    "version": "1.0.0",
    "description": "Hezz2, Ronda, Kdoub et Sota Ghamla : les jeux de cartes marocains, en ligne avec tes amis ou contre des bots.",
    "orientation": "default",
    "icon": "./assets/brand/icon-1024.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#1C0F13",
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C0F13"
    },
    "ios": {
      "bundleIdentifier": "fun.jebengere3.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fun.jebengere3.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#1C0F13"
      },
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "privacyPolicyUrl": "https://jebengere3.fun/privacy",
      "termsUrl": "https://jebengere3.fun/terms"
    },
    "web": {
      "favicon": "./assets/brand/favicon.png",
      "name": "Jeben Gere3",
      "shortName": "Jeben Gere3",
      "description": "Hezz2, Ronda, Kdoub et Sota Ghamla : les jeux de cartes marocains, en ligne avec tes amis ou contre des bots.",
      "themeColor": "#1C0F13",
      "backgroundColor": "#1C0F13",
      "display": "standalone",
      "orientation": "any",
      "lang": "fr"
    }
  }
}
